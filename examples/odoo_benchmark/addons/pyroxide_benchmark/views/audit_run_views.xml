<odoo>
    <record id="view_pyroxide_audit_run_tree" model="ir.ui.view">
        <field name="name">pyroxide.audit.run.tree</field>
        <field name="model">pyroxide.audit.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="anomaly_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_pyroxide_audit_run_form" model="ir.ui.view">
        <field name="name">pyroxide.audit.run.form</field>
        <field name="model">pyroxide.audit.run</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="anomaly_count"/>
                        <field name="state"/>
                        <field name="result_payload" filename="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pyroxide_audit_run" model="ir.actions.act_window">
        <field name="name">Ledger Audits</field>
        <field name="res_model">pyroxide.audit.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_pyroxide_audit_root" name="Ledger Audits" parent="account.menu_finance" sequence="95"/>
    <menuitem id="menu_pyroxide_audit_run" name="Audit Runs" parent="menu_pyroxide_audit_root" action="action_pyroxide_audit_run"/>
</odoo>
